# Auto detect text files and perform LF normalization on commit
* text=auto eol=lf

# Python, Config and Markdown files must always have LF line endings
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Jupyter Notebook clean filter (nbstripout)
*.ipynb filter=nbstripout
