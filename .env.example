# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env trên máy cá nhân và điền thông tin thực tế.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env THỰC TẾ LÊN KHO GIT!
# ==============================================================================

# 1. Cơ sở dữ liệu Data Warehouse
DB_HOST=10.0.0.10
DB_PORT=5432
DB_NAME=telecom_churn_dw
DB_USER=ds_readonly_user
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# 2. Kho Lưu trữ Đối tượng S3 / MinIO
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY
S3_BUCKET_NAME=churn-data-lake

# 3. Máy chủ Quản lý Thí nghiệm MLflow
MLFLOW_TRACKING_URI=http://mlflow.example.com:5000
MLFLOW_EXPERIMENT_NAME=churn_prediction_v1
